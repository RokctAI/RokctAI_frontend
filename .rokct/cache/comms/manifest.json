  "_comment": {
    "about": "Next.js half of comms_sdk, mirroring comms/dart. Ships the paas-era messaging surfaces (WhatsApp server action, the admin email/notifications/whatsapp settings pages, and the admin content/support notification pages) as flat templates in the one top-level installs list (no app_type persona blocks; role visibility is handled in the page code).",
    "app/(auth)/auth.ts": "host shell (not present in the frontend tree at dc7c0f7; users/auth SDK candidate)",
    "app/actions/base/admin/content.ts": "core/base (installed by base_sdk, this PR)",
    "app/actions/base/admin/settings.ts": "core/base (installed by base_sdk, this PR)",
    "app/actions/support/admin/support.ts": "productivity/support (installed by support_sdk, RokctAI/productivity PR #35)",
    "app/lib/i18n/index.ts": "host shell",
    "app/services/base/platform-gateway.ts": "core/base (installed by base_sdk >= 1.3.0, which carries paasCall on the kernel platform gateway)",
    "components/custom/WhatsAppLinkCard.tsx": "host shell (unmapped in paas-map)",
    "components/ui/button.tsx": "host shell",
    "components/ui/card.tsx": "host shell",
    "components/ui/input.tsx": "host shell",
    "components/ui/label.tsx": "host shell",
    "components/ui/switch.tsx": "host shell",
    "components/ui/table.tsx": "host shell"
  }
}
