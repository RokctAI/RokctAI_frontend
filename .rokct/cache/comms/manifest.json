{
  "name": "comms_sdk",
  "version": "1.1.0",
  "installs": [
    {
      "from": "templates/app/admin/content/notifications/page.tsx",
      "to": "app/admin/content/notifications/page.tsx"
    },
    {
      "from": "templates/app/admin/settings/email/page.tsx",
      "to": "app/admin/settings/email/page.tsx"
    },
    {
      "from": "templates/app/admin/settings/notifications/page.tsx",
      "to": "app/admin/settings/notifications/page.tsx"
    },
    {
      "from": "templates/app/admin/settings/whatsapp/page.tsx",
      "to": "app/admin/settings/whatsapp/page.tsx"
    },
    {
      "from": "templates/app/admin/support/notifications/page.tsx",
      "to": "app/admin/support/notifications/page.tsx"
    },
    {
      "from": "templates/app/actions/comms/whatsapp.ts",
      "to": "app/actions/comms/whatsapp.ts"
    }
  ],
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {},
  "integrations": [],
  "requires": [
    "app/(auth)/auth.ts",
    "app/actions/base/admin/content.ts",
    "app/actions/base/admin/settings.ts",
    "app/actions/support/admin/support.ts",
    "app/lib/i18n/index.ts",
    "app/services/base/platform-gateway.ts",
    "components/custom/WhatsAppLinkCard.tsx",
    "components/ui/button.tsx",
    "components/ui/card.tsx",
    "components/ui/input.tsx",
    "components/ui/label.tsx",
    "components/ui/switch.tsx",
    "components/ui/table.tsx"
